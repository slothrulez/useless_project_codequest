# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB OAUTH & API CONFIGURATION
# Set GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET for OAuth app connection
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GOOGLE OAUTH CONFIGURATION
# Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET for Google Sign-In OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Personal Access Token for direct GitHub integration
GITHUB_TOKEN=""

